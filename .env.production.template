# Production Environment Configuration for Laboratorios CRUB
# Copy this file to .env in production and update the values

# Environment
FLASK_ENV=production
APPLICATION_ROOT=/laboratorios-crub

# Server Configuration
SERVER_NAME=your-domain.com
PREFERRED_URL_SCHEME=https

# Security
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# La aplicación se niega a arrancar en producción con un valor de placeholder.
SECRET_KEY=generar-una-clave-nueva-y-unica

# Database (update for your production database)
DATABASE_URI=sqlite:///instance/laboratorios.db


# --- Quién puede entrar ----------------------------------------------------
# Los DNI habilitados, separados por coma. Keycloak dice si la persona es quien
# dice ser; esta lista dice si además puede usar esta aplicación.
#
# Se lee en cada ingreso: para dar o sacar acceso alcanza con editar esta línea,
# sin reiniciar el servicio.
#
# El rol (administrador o técnico) sigue saliendo del realm: app_admin o
# laboratorista. Quien esté en la lista pero no tenga ninguno de los dos entra
# como técnico.
USUARIOS_AUTORIZADOS=12345678,23456789


# --- Keycloak --------------------------------------------------------------
KEYCLOAK_SERVER_URL=https://huayca.crub.uncoma.edu.ar/keycloak/
KEYCLOAK_REALM=CRUB
KEYCLOAK_CLIENT_ID=laboratorios-crub-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# Sólo ponerlo en false para probar contra un Keycloak con certificado propio.
KEYCLOAK_VERIFY_SSL=true

# Restablecer la contraseña lo resuelven las pantallas de cuenta de Huayca.
# Esta aplicación no toca contraseñas: sólo manda a la persona allá.
URL_RESET_PASSWORD=https://huayca.crub.uncoma.edu.ar/quintral/reset-password

# Role Mapping
KEYCLOAK_ADMIN_ROLE=app_admin
KEYCLOAK_TECNICO_ROLE=laboratorista


# --- Sesión ----------------------------------------------------------------
# Tope duro, se siga usando o no.
SESION_HORAS=12

# Freno a los intentos fallidos: cuántos seguidos desde una misma IP antes de
# hacer esperar, y cuántos segundos.
INTENTOS_MAX=8
ESPERA_SEGUNDOS=300


# Logging
LOG_LEVEL=WARNING
LOG_DIR=/var/www/laboratorios-crub/logs

# Debug: mantener en false en producción.
KEYCLOAK_DEBUG=false
BROWSER_DEBUG=false
